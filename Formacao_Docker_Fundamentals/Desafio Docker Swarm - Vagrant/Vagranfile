# -*- mode: ruby -*-
# vi: set ft=ruby  :

machines = {
  "mestre" => {"memory" => "512", "cpu" => "1", "ip" => "10", "image" => "ubuntu/jammy64"},
  "no01" => {"memory" => "512", "cpu" => "1", "ip" => "11", "image" => "ubuntu/jammy64"},
  "no02" => {"memory" => "512", "cpu" => "1", "ip" => "12", "image" => "ubuntu/jammy64"}
}

Vagrant.configure("2") do |config|

  machines.each do |name, conf|
    config.vm.define "#{name}" do |machine|
      machine.vm.box = "#{conf["image"]}"
      machine.vm.hostname = "#{name}"
      machine.vm.network "private_network", ip: "192.168.15.#{conf["ip"]}"
      machine.vm.provider "virtualbox" do |vb|
        vb.name = "#{name}"
        vb.memory = conf["memory"]
        vb.cpus = conf["cpu"]
        
      end
      machine.vm.provision "shell", path: "docker.sh"
      
      if "#{name}" == "mestre"
        machine.vm.provision "shell", path: "master.sh"
      else
        machine.vm.provision "shell", path: "worker.sh"
      end

    end
  end
end